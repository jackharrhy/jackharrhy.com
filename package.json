{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "deploy": "node scripts/deploy.ts",
    "deploy:manifest": "node scripts/manifest.ts write",
    "verify": "pnpm format:check && npm run check && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check && tsc --noEmit",
    "astro:check": "astro check",
    "typecheck": "tsc --noEmit",
    "preview": "astro preview",
    "astro": "astro",
    "assets:diff": "node scripts/assets.ts diff",
    "assets:check": "node scripts/assets.ts check",
    "assets:missing:local": "node scripts/assets.ts missing-local",
    "assets:missing:remote": "node scripts/assets.ts missing-remote",
    "assets:pull:missing": "node scripts/assets.ts pull-missing",
    "assets:copy:to-r2": "node scripts/assets.ts copy-to-r2",
    "assets:sync:to-r2:dry-run": "node scripts/assets.ts sync-to-r2 --dry-run",
    "assets:sync:to-r2": "node scripts/assets.ts sync-to-r2",
    "linkblog:raindrop:status": "node scripts/linkblog-raindrop.ts status",
    "linkblog:raindrop:write-drafts": "node scripts/linkblog-raindrop.ts write-drafts",
    "linkblog:raindrop:sync-done:dry-run": "node scripts/linkblog-raindrop.ts sync-done",
    "linkblog:raindrop:sync-done": "node scripts/linkblog-raindrop.ts sync-done --apply"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/node": "^11.0.2",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.0.6",
    "htmx.org": "^2.0.10",
    "mime": "^4.1.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@bomb.sh/args": "^0.3.1",
    "@clack/prompts": "^1.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  }
}
