# Obsidian vault path (for content collections)
GARDEN_VAULT_PATH=./vault/Garden

# Obsidian vault assets path (for local dev asset serving)
GARDEN_VAULT_ASSETS_PATH=./vault/Assets

# Rclone remote bucket/subpath for Cloudflare R2 asset storage
GARDEN_RCLONE_REMOTE=jacks-garden:jacks-garden

# Cloudflare R2 (for direct API access; rclone is used by asset scripts)
GARDEN_R2_ACCESS_KEY=
GARDEN_R2_SECRET_KEY=
GARDEN_R2_BUCKET=jacks-garden
GARDEN_CLOUDFLARE_ACCOUNT_ID=

# Optional: Raindrop.io for linkblog import
GARDEN_RAINDROP_TOKEN=
GARDEN_RAINDROP_COLLECTION=Logseq To Import
GARDEN_RAINDROP_IMPORTED_COLLECTION=Logseq Imported
GARDEN_RAINDROP_CACHE_MS=300000
GARDEN_OBSIDIAN_VAULT=vault

# Optional: Last.fm for now-playing widget
JACKHARRHY_LASTFM_API_KEY=
