---
import { getCollection, getEntry } from "astro:content";

import Layout from "../layouts/Layout.astro";
import { resolveOgImage } from "../utils";
import {
  getBreadcrumbs,
  getDisplayName,
  getPageLayoutConfig,
  getRenderedTitle,
  shouldIncludeTitleInBreadcrumbs,
} from "../lib/page";
import { renderMarkdownSegments } from "../lib/markdown";
import PageHeader from "./PageHeader.astro";
import PageContent from "./PageContent.astro";

const { id, header = true } = Astro.props;

if (!id) {
  throw new Error("Page ID is required");
}

const entry = await getEntry("garden", id);

if (!entry || !entry.data.public) {
  return Astro.rewrite("/404");
}

const customLayout = entry.data.custom_layout || entry.data["custom-layout"];
const layout = getPageLayoutConfig(customLayout, header);
const displayName = getDisplayName(entry);
const publicEntryIds = new Set(
  (await getCollection("garden", ({ data }) => data.public)).map(
    (entry) => entry.id,
  ),
);
const breadcrumbs = getBreadcrumbs(entry, displayName, publicEntryIds);
const title = getRenderedTitle(entry, displayName);
const renderedSegments = await renderMarkdownSegments(entry.body ?? "");
const titlePartOfBreadcrumbs = shouldIncludeTitleInBreadcrumbs(entry.id);
---

<Layout
  title={displayName === "Home" ? undefined : displayName}
  description={entry.data.description}
  noFooter={layout.noFooter}
  ogImage={resolveOgImage(entry.data["og-image"])}
  width={layout.width}
  mainClass={layout.mainClass}
  invert={layout.invert}
  mobileFriendly={layout.mobileFriendly}
>
  {
    !layout.noHeader && (
      <PageHeader
        breadcrumbs={breadcrumbs}
        title={title}
        centerHeader={layout.centerHeader}
      />
    )
  }

  {
    entry.data.description && !titlePartOfBreadcrumbs && (
      <p class="not-prose text-2xl font-medium mb-10">
        {entry.data.description}
      </p>
    )
  }

  <PageContent segments={renderedSegments} pageId={entry.id} />
</Layout>
