---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import { getLinkblogRaindropStatus } from "../../lib/linkblog-raindrop";

if (!import.meta.env.DEV) {
  return new Response("Not found", { status: 404 });
}

let status;
let error: string | null = null;
let nextTodoDates: [string, NonNullable<typeof status>["todo"]][] = [];
const obsidianVault = import.meta.env.GARDEN_OBSIDIAN_VAULT || "vault";

function obsidianUrlForDraftPage(draftPage: string) {
  const file = "Garden/" + draftPage;
  return `obsidian://open?${new URLSearchParams({
    vault: obsidianVault,
    file,
  })}`;
}

try {
  status = await getLinkblogRaindropStatus({
    token: import.meta.env.GARDEN_RAINDROP_TOKEN,
    collectionTitle: import.meta.env.GARDEN_RAINDROP_COLLECTION,
    vaultPath: import.meta.env.GARDEN_VAULT_PATH,
    refresh: Astro.url.searchParams.has("refresh"),
  });
  nextTodoDates = Object.entries(status.todoByDate)
    .sort(([a], [b]) => a.localeCompare(b))
    .slice(0, 3);
} catch (err) {
  error = err instanceof Error ? err.message : String(err);
}

if (Astro.request.headers.get("accept")?.includes("application/json")) {
  return new Response(JSON.stringify(error ? { error } : status), {
    status: error ? 500 : 200,
    headers: { "Content-Type": "application/json" },
  });
}
---

<Layout title="Debug Linkblog">
  <p><a href="/debug">← Debug</a></p>

  <h1>Linkblog Raindrop</h1>

  {
    error ? (
      <p>{error}</p>
    ) : (
      status && (
        <>
          <p>
            Collection: <code>{status.collectionTitle}</code>{" "}
            <small>
              <a href="/debug/linkblog?refresh">refresh cache</a>
            </small>
          </p>
          <p>
            Days: {status.totalDays} total · {status.todoDays} todo ·{" "}
            {status.completedDays} completed
          </p>
          <p>
            Links: {status.total} total · {status.todo.length} todo ·{" "}
            {status.completed.length} completed
          </p>

          <h2>Next Todo Days</h2>
          {nextTodoDates.length === 0 ? (
            <p>No pending Raindrop items.</p>
          ) : (
            nextTodoDates.map(([date, items]) => (
              <section>
                <h3>
                  {date}{" "}
                  <small>
                    ({items.length} links) → {items[0].draftPage} ·{" "}
                    <a href={obsidianUrlForDraftPage(items[0].draftPage)}>
                      open in Obsidian
                    </a>
                  </small>
                </h3>
                <ul>
                  {items.map((item) => (
                    <li>
                      <a href={item.link}>{item.title}</a>
                      {item.excerpt && <blockquote>{item.excerpt}</blockquote>}
                    </li>
                  ))}
                </ul>
              </section>
            ))
          )}
        </>
      )
    )
  }
</Layout>
