---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = await getEntry('garden', 'projects');
if (!projects) throw new Error('Projects.md not found');

const { Content } = await render(projects);
const title = projects.data.title || 'Projects';
---

<BaseLayout title={title}>
  <h1>{title}</h1>
  <Content />
</BaseLayout>
